{
  "name": "ffconv-gui",
  "productName": "FFConv GUI",
  "version": "0.1.0",
  "private": true,
  "description": "FFConv GUI - FFmpeg desktop client",
  "author": "Big Cat <mcxiaoke@foxmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ensure:electron": "electron --version",
    "predev": "npm run ensure:electron",
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remote-debugging-port=9222",
    "prebuild": "npm run ensure:electron",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "package:win": "npm run build && electron-builder --win && node ./scripts/post_package.cjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "chalk": "^6.0.1",
    "cli-progress": "^3.12.0",
    "dayjs": "^1.11.19",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "execa": "^10.0.1",
    "fdir": "^6.5.0",
    "fs-extra": "^11.3.3",
    "globals": "^17.12.0",
    "iconv-lite": "^0.7.3",
    "js-xxhash": "^5.0.1",
    "js-yaml": "^5.4.2",
    "loglevel": "^1.9.1",
    "loglevel-plugin-prefix": "^0.8.4",
    "music-metadata": "^11.16.1",
    "p-map": "^7.0.4",
    "systeminformation": "^5.33.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "which": "^7.0.0"
  }
}
